# LinguaPulse AI 配置
# 复制此文件为 config.properties 并填入你的 API Key

# DeepSeek（推荐，国内可用）
llm.provider=deepseek
llm.api.key=sk-your-deepseek-key
llm.base.url=https://api.deepseek.com/v1
llm.model=deepseek-chat

